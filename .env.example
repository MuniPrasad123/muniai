# Copy to .env for local use. Never commit the resulting file.
# Local defaults through Phase 5.

MUNIAI_HOST=127.0.0.1
MUNIAI_DATA_DIR=./local-data

# Verified local Ollama defaults.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MUNIAI_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300
MUNIAI_CHAT_MAX_MESSAGE_LENGTH=10000

# Native local PostgreSQL. Keep the real password out of Git.
MUNIAI_DB_URL=jdbc:postgresql://127.0.0.1:5432/muniai
MUNIAI_DB_USERNAME=muniai
MUNIAI_DB_PASSWORD=replace-with-a-local-secret

# Original documents remain under ignored local storage; metadata and extracted text use PostgreSQL.
MUNIAI_DOCUMENT_UPLOAD_DIR=../../local-data/documents
MUNIAI_DOCUMENT_MAX_SIZE=10MB
MUNIAI_DOCUMENT_MAX_REQUEST_SIZE=11MB
