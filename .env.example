# Copy to .env for local use. Never commit the resulting file.
# Phase 0/1 local defaults. No application runtime is active yet.

MUNIAI_HOST=127.0.0.1
MUNIAI_DATA_DIR=./local-data

# Verified local Ollama defaults.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MUNIAI_CHAT_MODEL=llama3.2:3b
MUNIAI_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=120

# Future services; placeholders only.
POSTGRES_DATABASE=muniai
POSTGRES_USERNAME=muniai
POSTGRES_PASSWORD=replace-with-a-local-secret
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
